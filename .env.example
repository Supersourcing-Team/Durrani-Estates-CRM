# API host only (no /v1) — paths are defined in src/http/apiEndpoint.ts
VITE_API_BASE_URL=https://durrani-backend-production.up.railway.app

# Dev: Vite proxies /v1 → host above (avoids CORS)
VITE_API_USE_PROXY=true

# Frontend origin used in invite / reset emails (tell backend to use this, NOT the API host)
# Dev example:  http://localhost:4200
# Link formats backend may send (both work once they hit this frontend):
#   {VITE_APP_URL}/#invite-{token}
#   {VITE_APP_URL}/accept-invite?token={token}
VITE_APP_URL=http://localhost:4200
